<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#12191F" RequestedTheme="Dark">
 <Grid.Resources>
  <SolidColorBrush x:Key="Accent" Color="#7CD2DD" />
  <Style x:Key="Nav" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,12"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5B7C4"/><Setter Property="FontSize" Value="12"/><Setter Property="CharacterSpacing" Value="70"/></Style>
  <Style x:Key="SettingsSection" TargetType="TextBlock"><Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#EFF3F5"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="SettingsDisclosure" TargetType="Expander"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border x:Name="TitleBar" Background="#172129" Padding="18,0,160,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image x:Name="TitleBrandIcon" Width="20" Height="20" AutomationProperties.AccessibilityView="Raw"/><TextBlock Text="Storage" FontSize="13"/><TextBlock Text="/  Local workspace" FontSize="12" Foreground="#A5B7C4"/></StackPanel></Border>
 <Grid x:Name="WorkspaceColumns" Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="344"/></Grid.ColumnDefinitions>
  <Border Background="#172129" BorderBrush="#293640" BorderThickness="0,0,1,0" Padding="12,22,12,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="6">

    <Button x:Name="ItemsNav" AutomationProperties.Name="All items" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE80A;" FontSize="17"/><TextBlock Text="All items"/></StackPanel></Button>
    <Button x:Name="CollectionsNav" AutomationProperties.Name="Collections" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE8F1;" FontSize="17"/><TextBlock Text="Collections"/></StackPanel></Button>
   </StackPanel>
   <Button Grid.Row="2" x:Name="SettingsNav" AutomationProperties.Name="Settings" Style="{StaticResource Nav}"><StackPanel Orientation="Horizontal" Spacing="14"><FontIcon Glyph="&#xE713;" FontSize="17"/><TextBlock Text="Settings"/></StackPanel></Button>
  </Grid></Border>
  <Grid x:Name="WorkspaceContent" Grid.Column="1" Padding="28,22,28,26" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel Spacing="6"><TextBlock x:Name="Heading" Text="All items" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="A place for what matters." Foreground="#A5B7C4" FontSize="13"/></StackPanel><Button x:Name="ImportButton" Content="＋  Import files" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#246B80" BorderThickness="0" Padding="18,10"/></Grid>
   <StackPanel Grid.Row="1" Spacing="12"><InfoBar x:Name="Notice" IsOpen="False" Severity="Error" IsClosable="True"/><ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" Height="3"/></StackPanel>
   <Grid x:Name="Toolbar" Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" PlaceholderText="Search this view" AutomationProperties.Name="Search items"/><Button x:Name="LayoutButton" Grid.Column="1" Content="Grid view"/><Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh"/></Grid>
   <Grid Grid.Row="3">
    <Grid x:Name="BrowseHost" AllowDrop="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="CollectionFilter" Visibility="Collapsed" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/><ContentControl x:Name="ItemsHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/><StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><Image x:Name="EmptyBrandIcon" Width="48" Height="48" AutomationProperties.AccessibilityView="Raw"/><TextBlock x:Name="EmptyTitle" Text="Your space, ready for its first item" FontSize="19" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Import files or drop them here. Original versions stay intact." Foreground="#91A6B5" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/></StackPanel></Grid>
    <StackPanel x:Name="CollectionsPanel" Visibility="Collapsed" Spacing="14"><StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="CollectionName" PlaceholderText="New collection name" Width="220"/><Button x:Name="CreateCollectionButton" Content="Create"/></StackPanel><TextBlock Text="Collections organize items without copying their content." Foreground="#91A6B5" TextWrapping="Wrap"/><ListView x:Name="CollectionsList" IsItemClickEnabled="True" SelectionMode="None"/></StackPanel>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Margin="0,24,0,0">
     <StackPanel x:Name="SettingsContent" MaxWidth="720" HorizontalAlignment="Stretch" Spacing="26" Padding="0,0,8,20">

      <StackPanel>
       <TextBlock Text="Updates" Style="{StaticResource SettingsSection}"/>
       <Grid Margin="0,0,0,16" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ApplicationVersion" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/><Button x:Name="CheckUpdates" Grid.Column="1" Content="Check for updates" Padding="14,9"/></Grid>
       <Border Background="#1C2933" BorderBrush="#32424E" BorderThickness="1" CornerRadius="8" Padding="20,18">
        <StackPanel Spacing="12">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateTitle" Text="Not checked yet" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="OfferedVersion" Grid.Column="1" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"/></Grid>
         <TextBlock x:Name="UpdateStatus" AutomationProperties.LiveSetting="Polite" Text="Check for updates when you choose." TextWrapping="Wrap" Foreground="#A5B7C4"/>
         <Expander x:Name="WhatsNew" IsExpanded="False" Visibility="Collapsed" Style="{StaticResource SettingsDisclosure}">
          <Expander.Header><Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="What’s new" FontWeight="SemiBold"/><TextBlock x:Name="ChangeCount" Grid.Column="1" Foreground="#A5B7C4" FontSize="12" VerticalAlignment="Center"/></Grid></Expander.Header>
          <StackPanel Spacing="14">
           <TextBlock x:Name="NotesStatus" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Foreground="#A5B7C4"/>
           <Button x:Name="RetryChangelog" Content="Retry changelog" Visibility="Collapsed"/>
           <StackPanel x:Name="NotesGroups" Spacing="12"/>
           <Expander x:Name="CommitDetails" Header="Commit details" IsExpanded="False" Visibility="Collapsed" Style="{StaticResource SettingsDisclosure}"><StackPanel Spacing="10"><TextBlock x:Name="SourceRange" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" Foreground="#A5B7C4"/><StackPanel x:Name="CommitSubjects" Spacing="8"/></StackPanel></Expander>
          </StackPanel>
         </Expander>
         <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100" AutomationProperties.Name="Update download progress" Height="4"/>
         <Button x:Name="DownloadUpdate" Content="Download update" Visibility="Collapsed" Background="{StaticResource Accent}" Foreground="#10212A" BorderThickness="0" FontWeight="SemiBold" Padding="16,10"/>
         <Button x:Name="RestartUpdate" Content="Restart and install" Visibility="Collapsed" Background="{StaticResource Accent}" Foreground="#10212A" BorderThickness="0" FontWeight="SemiBold" Padding="16,10"/>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel>
       <TextBlock Text="Local service" Style="{StaticResource SettingsSection}"/>
       <Border Background="#1C2933" BorderBrush="#32424E" BorderThickness="1" CornerRadius="8" Padding="20,18">
        <StackPanel Spacing="16">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock Text="Storage service" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="This device · Local workspace" Foreground="#A5B7C4" FontSize="12"/></StackPanel><TextBlock x:Name="ServiceHealth" Grid.Column="1" Text="Not connected" Foreground="{StaticResource Accent}" VerticalAlignment="Top" AutomationProperties.LiveSetting="Polite"/></Grid>
         <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Repository" Foreground="#A5B7C4"/><TextBlock x:Name="ServiceRepository" Grid.Column="1" Text="Unavailable" TextWrapping="Wrap"/></Grid>
         <Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Local owner" Foreground="#A5B7C4"/><TextBlock Text="local-owner" Grid.Column="1"/></Grid>
         <Expander x:Name="TechnicalDetails" Header="Technical details" IsExpanded="False" Style="{StaticResource SettingsDisclosure}"><StackPanel Spacing="14"><TextBlock x:Name="ServiceDetails" Text="Device and data store IDs unavailable." Foreground="#A5B7C4" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock Text="Application build" Foreground="#A5B7C4" FontSize="12"/><TextBlock x:Name="ApplicationBuild" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></Expander>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel>
       <TextBlock Text="About Storage" Style="{StaticResource SettingsSection}"/>
       <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image x:Name="AboutBrandIcon" Width="36" Height="36" AutomationProperties.AccessibilityView="Raw" VerticalAlignment="Top" Margin="0,4,0,0"/>
        <StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Storage for Windows" FontWeight="SemiBold"/><TextBlock Text="Your files. One private store. No cloud account required." Foreground="#A5B7C4" FontSize="12" TextWrapping="Wrap"/>
         <Expander x:Name="SecurityDetails" Header="Security and build information" IsExpanded="False" Style="{StaticResource SettingsDisclosure}"><StackPanel Spacing="10">
          <TextBlock Text="The independent per-user service owns the repository. Unregistered applications are denied. This is not a sandbox against same-user full-trust malware or an administrator." TextWrapping="Wrap" FontSize="12" Foreground="#A5B7C4"/>
          <TextBlock Text="Changed Browser binaries require new service-owned approval. Updates replace application binaries, not your repository or consent state." TextWrapping="Wrap" FontSize="12" Foreground="#A5B7C4"/>
          <TextBlock Text="Windows releases are unsigned; only install updates you trust. Published placeholder versions need one manual in-place installer upgrade to acquire in-app updates. Do not uninstall or clear service data." TextWrapping="Wrap" FontSize="12" Foreground="#A5B7C4"/>
          <TextBlock Text="Packaged Browser identity is preferred. Unpackaged installed builds require explicit service-owned consent; development builds require explicit hash enrollment. See the Windows README." TextWrapping="Wrap" FontSize="12" Foreground="#A5B7C4"/>
          <TextBlock Text="Device pairing, replication, saved queries and placement policies are not implemented in this local build." TextWrapping="Wrap" FontSize="12" Foreground="#A5B7C4"/>
         </StackPanel></Expander>
        </StackPanel>
       </Grid>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="4" Text="Connecting to local service…" Foreground="#91A6B5" FontSize="12" TextWrapping="Wrap"/>
  </Grid>
  <Border x:Name="InspectorHost" Grid.Column="2" Background="#172129" BorderBrush="#293640" BorderThickness="1,0,0,0" Padding="22,30,22,20"><ScrollViewer><StackPanel Spacing="18"><TextBlock Text="ITEM INSPECTOR" Style="{StaticResource Label}"/><StackPanel x:Name="InspectorEmpty" Spacing="10" Margin="0,24,0,0"><TextBlock Text="A closer look" FontSize="23"/><TextBlock Text="Select an item to inspect its generated attributes, access policy and immutable history." Foreground="#91A6B5" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="Inspector" Visibility="Collapsed" Spacing="16"><TextBlock x:Name="ItemName" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ItemType" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ExportButton" Content="Export…"/><Button x:Name="NewVersionButton" Content="New version…"/></StackPanel><TextBlock Text="ATTRIBUTES" Style="{StaticResource Label}"/><TextBlock x:Name="Attributes" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/><TextBlock Text="ACCESS" Style="{StaticResource Label}"/><TextBlock x:Name="Access" TextWrapping="Wrap" Foreground="#B1C1CD" FontSize="12"/><TextBlock Text="NAME" Style="{StaticResource Label}"/><TextBox x:Name="RenameText" AutomationProperties.Name="Item name"/><Button x:Name="RenameButton" Content="Rename"/><TextBlock Text="COLLECTION" Style="{StaticResource Label}"/><ComboBox x:Name="CollectionChoice" PlaceholderText="Choose collection" HorizontalAlignment="Stretch"/><Button x:Name="AddCollectionButton" Content="Add to collection"/><TextBlock Text="VERSION HISTORY" Style="{StaticResource Label}"/><TextBlock Text="Select a version to export its original bytes." Foreground="#91A6B5" FontSize="12" TextWrapping="Wrap"/><StackPanel x:Name="Versions" Spacing="8"/></StackPanel></StackPanel></ScrollViewer></Border>
 </Grid>
</Grid>
