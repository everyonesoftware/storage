<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#12191F" RequestedTheme="Dark">
 <Grid.Resources>
  <SolidColorBrush x:Key="Accent" Color="#55C4D2" />
  <Style x:Key="Nav" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,12"/><Setter Property="CornerRadius" Value="8"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#91A6B5"/><Setter Property="FontSize" Value="12"/><Setter Property="CharacterSpacing" Value="70"/></Style>
 </Grid.Resources>
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Border x:Name="TitleBar" Background="#172129" Padding="18,0,160,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE8B7;" FontSize="15" Foreground="{StaticResource Accent}"/><TextBlock Text="Storage" FontSize="13"/><TextBlock Text="/  Local workspace" FontSize="12" Foreground="#91A6B5"/></StackPanel></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition Width="*"/><ColumnDefinition Width="344"/></Grid.ColumnDefinitions>
  <Border Background="#172129" BorderBrush="#293640" BorderThickness="0,0,1,0" Padding="14,30,14,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="6"><TextBlock Text="YOUR WORKSPACE" Style="{StaticResource Label}" Margin="14,0,0,18"/><Button x:Name="ItemsNav" Content="All items" Style="{StaticResource Nav}"/><Button x:Name="CollectionsNav" Content="Collections" Style="{StaticResource Nav}"/><Button x:Name="SettingsNav" Content="Settings" Style="{StaticResource Nav}"/></StackPanel>
   <StackPanel Grid.Row="2" Spacing="8" Margin="14,0"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="{StaticResource Accent}"/><TextBlock Text="LOCAL FIRST" Style="{StaticResource Label}"/></StackPanel><TextBlock Text="Your files. One private store.&#xA;No cloud account required." FontSize="12" Foreground="#91A6B5" TextWrapping="Wrap"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Padding="30,28,26,20" RowSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><StackPanel Spacing="6"><TextBlock x:Name="Heading" Text="All items" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="A place for what matters." Foreground="#91A6B5" FontSize="13"/></StackPanel><Button x:Name="ImportButton" Content="＋  Import files" HorizontalAlignment="Right" VerticalAlignment="Center" Background="#246B80" BorderThickness="0" Padding="18,10"/></Grid>
   <StackPanel Grid.Row="1" Spacing="12"><InfoBar x:Name="Notice" IsOpen="False" Severity="Error" IsClosable="True"/><ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" Height="3"/></StackPanel>
   <Grid x:Name="Toolbar" Grid.Row="2" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" PlaceholderText="Search this view" AutomationProperties.Name="Search items"/><Button x:Name="LayoutButton" Grid.Column="1" Content="Grid view"/><Button x:Name="RefreshButton" Grid.Column="2" Content="Refresh"/></Grid>
   <Grid Grid.Row="3">
    <Grid x:Name="BrowseHost" AllowDrop="True"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="CollectionFilter" Visibility="Collapsed" Foreground="{StaticResource Accent}" Margin="0,0,0,12"/><ContentControl x:Name="ItemsHost" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/><StackPanel x:Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="40" Foreground="#55C4D2"/><TextBlock x:Name="EmptyTitle" Text="Your space, ready for its first item" FontSize="19" HorizontalAlignment="Center"/><TextBlock x:Name="EmptyText" Text="Import files or drop them here. Original versions stay intact." Foreground="#91A6B5" TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center"/></StackPanel></Grid>
    <StackPanel x:Name="CollectionsPanel" Visibility="Collapsed" Spacing="14"><StackPanel Orientation="Horizontal" Spacing="8"><TextBox x:Name="CollectionName" PlaceholderText="New collection name" Width="220"/><Button x:Name="CreateCollectionButton" Content="Create"/></StackPanel><TextBlock Text="Collections organize items without copying their content." Foreground="#91A6B5" TextWrapping="Wrap"/><ListView x:Name="CollectionsList" IsItemClickEnabled="True" SelectionMode="None"/></StackPanel>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed"><StackPanel Spacing="20"><TextBlock Text="Storage for Windows" FontSize="22"/><TextBlock x:Name="ApplicationVersion" Foreground="#91A6B5"/><Border Background="#1C2933" CornerRadius="10" Padding="20"><StackPanel Spacing="12"><TextBlock Text="Application updates" FontSize="18"/><TextBlock x:Name="UpdateStatus" AutomationProperties.LiveSetting="Polite" Text="Check for Windows updates when you choose." TextWrapping="Wrap" Foreground="#B1C1CD"/><ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100" AutomationProperties.Name="Update download progress"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdates" Content="Check for updates"/><Button x:Name="DownloadUpdate" Content="Download update" Visibility="Collapsed"/><Button x:Name="RestartUpdate" Content="Restart and install" Visibility="Collapsed"/></StackPanel><TextBlock Text="Updates replace application binaries, not your repository or consent state. Changed Browser binaries require new service-owned approval. Windows releases are unsigned; only install updates you trust." TextWrapping="Wrap" Foreground="#91A6B5"/></StackPanel></Border><TextBlock Text="Service and security" FontSize="18"/><TextBlock x:Name="ServiceHealth" Text="Not connected." TextWrapping="Wrap" Foreground="#B1C1CD"/><TextBlock Text="The independent per-user service owns the repository. Unregistered applications are denied. Packaged Browser identity is preferred; unpackaged development builds require explicit hash enrollment in the service console. See the Windows README." TextWrapping="Wrap" Foreground="#91A6B5"/><TextBlock Text="Device pairing, replication, saved queries and placement policies are not implemented in this local build." TextWrapping="Wrap" Foreground="#91A6B5"/></StackPanel></ScrollViewer>
   </Grid>
   <TextBlock x:Name="Status" Grid.Row="4" Text="Connecting to local service…" Foreground="#91A6B5" FontSize="12" TextWrapping="Wrap"/>
  </Grid>
  <Border Grid.Column="2" Background="#172129" BorderBrush="#293640" BorderThickness="1,0,0,0" Padding="22,30,22,20"><ScrollViewer><StackPanel Spacing="18"><TextBlock Text="ITEM INSPECTOR" Style="{StaticResource Label}"/><StackPanel x:Name="InspectorEmpty" Spacing="10" Margin="0,24,0,0"><TextBlock Text="A closer look" FontSize="23"/><TextBlock Text="Select an item to inspect its generated attributes, access policy and immutable history." Foreground="#91A6B5" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="Inspector" Visibility="Collapsed" Spacing="16"><TextBlock x:Name="ItemName" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ItemType" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ExportButton" Content="Export…"/><Button x:Name="NewVersionButton" Content="New version…"/></StackPanel><TextBlock Text="ATTRIBUTES" Style="{StaticResource Label}"/><TextBlock x:Name="Attributes" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12"/><TextBlock Text="ACCESS" Style="{StaticResource Label}"/><TextBlock x:Name="Access" TextWrapping="Wrap" Foreground="#B1C1CD" FontSize="12"/><TextBlock Text="NAME" Style="{StaticResource Label}"/><TextBox x:Name="RenameText" AutomationProperties.Name="Item name"/><Button x:Name="RenameButton" Content="Rename"/><TextBlock Text="COLLECTION" Style="{StaticResource Label}"/><ComboBox x:Name="CollectionChoice" PlaceholderText="Choose collection" HorizontalAlignment="Stretch"/><Button x:Name="AddCollectionButton" Content="Add to collection"/><TextBlock Text="VERSION HISTORY" Style="{StaticResource Label}"/><TextBlock Text="Select a version to export its original bytes." Foreground="#91A6B5" FontSize="12" TextWrapping="Wrap"/><StackPanel x:Name="Versions" Spacing="8"/></StackPanel></StackPanel></ScrollViewer></Border>
 </Grid>
</Grid>
